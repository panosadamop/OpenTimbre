{
  "name": "opentimbre",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "fixtures": "node tools/generate-fixtures.mjs",
    "pages:dev": "wrangler pages dev dist --compatibility-date=2025-09-01 --binding BACKEND_URL=http://127.0.0.1:8000",
    "pages:deploy": "npm run build && wrangler pages deploy dist --project-name opentimbre"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "wrangler": "^4.166.0"
  }
}
