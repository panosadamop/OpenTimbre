{
  // Cloudflare Workers deployment of OpenTimbre Studio.
  // Dashboard (Workers & Pages > Create > Import a repository):
  //   Build command:  npm run build      Deploy command: npx wrangler deploy
  // Then set the BACKEND_URL variable (Settings > Variables and Secrets).
  // The classic Pages flow ignores this file and uses functions/ instead.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opentimbre",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
